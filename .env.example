# Deploy settings. Locally, export these before `bun run deploy`. In GitHub Actions they
# live in the "production" environment (see .github/workflows/deploy.yml).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional custom domain on a zone in the same account. Leave empty to use workers.dev.
DEPLOY_DOMAIN=
# Optional Worker variables for GitHub Actions, one KEY:VALUE per line, e.g.
# MESSAGE_MAX_AGE_SECONDS:300
DEPLOY_VARS=

# Used by `bun run webhook set`: the Worker's public origin.
WORKER_URL=

# Worker secrets are listed in .dev.vars.example (set with `bunx wrangler secret put NAME`).
