{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tg-translator",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "tg-translator.oliinyk.dev", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "MESSAGE_MAX_AGE_SECONDS": "300"
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "DEEPL_API_KEY",
      "CHANNEL_ID",
      "DISCUSSION_GROUP_ID"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tg-translator",
      "migrations_dir": "migrations"
    }
  ]
}
